PORT=6991
MONGO_URI=mongodb://127.0.0.1:27017/WalletTracker
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# Redis (optional — caching gracefully falls back to no-op when Redis is unavailable)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=true

# Scheduler
SCHEDULER_DISABLED=false

# Resend (password reset emails). Leave RESEND_API_KEY unset to run in dev mode
# (the reset code is returned in the API response instead of emailed).
# Get a key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
MAIL_FROM="Wallet Tracker <no-reply@wallettracker.app>"
